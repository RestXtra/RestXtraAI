[Unit]
Description=RestXtraAI C2 teamserver
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# 修改为实际二进制路径（VPS 正式 / 本地 Linux VM 测试）
ExecStart=/opt/restxtra/restxtra -addr 0.0.0.0:8787 -proxy 0.0.0.0:8788
Restart=on-failure
RestartSec=3
# 数据库连接：通过环境变量注入（或用 config.json）
Environment=RESTXTRA_PG_DSN=postgres://restxtra:CHANGE_ME@127.0.0.1:5432/restxtra_ai?sslmode=disable
WorkingDirectory=/opt/restxtra
# 运行用户（非 root）
User=restxtra
Group=restxtra
# 安全加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target