# Docker 部署配置（复制为 .env）
RESTXTRA_TAG=latest
POSTGRES_USER=restxtra
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=restxtra
POSTGRES_PORT=5432

# 默认仅本机可访问。只有在前置 HTTPS 反向代理/防火墙已配置时才改为 0.0.0.0。
RESTXTRA_BIND_IP=127.0.0.1
RESTXTRA_HTTP_PORT=8787
RESTXTRA_PROXY_PORT=8788

# 设为 disabled 可在只读演示环境完全关闭 Agent 宿主命令执行。
RESTXTRA_HOST_EXECUTION=enabled

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESTXTRA_LLM_PROVIDER=
RESTXTRA_LLM_MODEL=
RESTXTRA_LLM_BASE_URL=
RESTXTRA_LLM_PROXY=
