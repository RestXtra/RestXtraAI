# Normalize line endings: Go + shell + frontend sources as LF.
* text=auto

*.go text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.mjs text eol=lf

# Binary / generated
*.png binary
*.ico binary
*.lock binary
*.sum text eol=lf
